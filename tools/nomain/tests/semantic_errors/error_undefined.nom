// ERROR TEST: Undefined variable
// This program intentionally uses an undefined variable 'greeting'
// Expected error: "Variable 'greeting' not defined"
// This demonstrates the strict variable declaration requirement

[DATA_STORAGE]
[GLOBAL]
    

[APPLICATION-STARTUP]
function main() -> [VOID] {
    say(greeting);  // ERROR: 'greeting' is not declared
    say("A + B = ");
    say(add(10,20));
    say_f("a + b = ", add(10,20));
}

function add(INT a, INT b) -> INT {
    RETURN a + b;
}